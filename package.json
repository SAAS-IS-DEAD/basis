{
  "name": "basis",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "bun --bun run nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p tests/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "^2.6.0",
    "cssnano": "^9.9.0",
    "happy-dom": "^21.0.4",
    "sass": "^1.93.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "vue-tsc": "3.3.14"
  }
}
